{
  "name": "y7sk",
  "version": "0.1.0",
  "description": "Modern desktop client for SoundCloud",
  "productName": "Y7SK",
  "author": {
    "name": "9sx77ssl",
    "email": "9sx77ssl@users.noreply.github.com"
  },
  "homepage": "https://github.com/9sx77ssl/Y7SK",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/9sx77ssl/Y7SK.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "start": "electron-vite preview",
    "build": "bun run typecheck && electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "bun run typecheck:node && bun run typecheck:web",
    "pack:dir": "bun run build && electron-builder --dir",
    "dist:linux": "bun run build && electron-builder --linux AppImage deb",
    "dist:win": "bun run build && electron-builder --win nsis portable",
    "dist:mac": "bun run build && electron-builder --mac dmg",
    "icons": "bun scripts/generate-icons.mjs",
    "postinstall": "node node_modules/electron/install.js || bun node_modules/electron/install.js"
  },
  "trustedDependencies": [
    "electron",
    "esbuild"
  ],
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron-toolkit/utils": "^4.0.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^5.0.0",
    "png2icons": "^2.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "typescript": "^6.0.3",
    "vite": "^7.3.3",
    "zustand": "^5.0.14"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.17.3",
    "electron-store": "^11.0.2"
  }
}
